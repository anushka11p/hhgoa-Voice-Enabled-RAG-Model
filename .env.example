# ---- Speech-to-text (required only for the voice path) ----
# Get a key from https://dashboard.sarvam.ai
# The text endpoint /api/ask works without this.
SARVAM_API_KEY=your_sarvam_key_here

# ---- Optional: LLM generation path ----
# Leave unset to use the default extractive generator, which is what keeps the
# pipeline inside the 200 ms budget. Set this plus GENERATION_MODE=llm for
# fluent synthesized answers at higher latency.
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GENERATION_MODE=extractive        # extractive | llm | auto

# ---- Language ----
# hi = Hindi end to end (default). en = English models + corpus.
# RAG_LANG=hi

# ---- Performance ----
# Single-threaded is measurably faster and far more predictable for
# one-query-at-a-time inference. Raise only if you benchmark a gain.
# TORCH_NUM_THREADS=1
# CORE_BUDGET_MS=200

# ---- Retrieval / chunking ----
# ACTIVE_CHUNK_STRATEGY=recursive   # fixed | semantic | recursive | metadata
# FINAL_TOP_K=4
